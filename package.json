{
  "name": "git-pilot",
  "version": "1.0.0",
  "description": "Git workflow automation with issue tracker integration — MCP-powered",
  "type": "module",
  "bin": {
    "git-pilot": "dist/cli/index.js",
    "git-pilot-mcp": "dist/mcp/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "test:cov": "vitest run --coverage",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "format": "prettier --write src/**/*.ts"
  },
  "author": "Jun",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "git",
    "workflow",
    "developer-tools",
    "commit-message",
    "issue-tracker",
    "mcp",
    "typescript",
    "notion",
    "jira",
    "github-issues"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@notionhq/client": "^5.11.1",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.3.0",
    "js-yaml": "^4.1.1",
    "ora": "^9.3.0",
    "simple-git": "^3.32.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/inquirer": "^9.0.9",
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  }
}
